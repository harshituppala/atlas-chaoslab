{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SameDeviceTemporaryLoginOnly",
      "Effect": "Allow",
      "Action": [
        "signin:AuthorizeOAuth2Access",
        "signin:CreateOAuth2Token"
      ],
      "Resource": "arn:aws:signin:us-east-1:ACCOUNT_ID:oauth2/public-client/localhost"
    }
  ]
}
